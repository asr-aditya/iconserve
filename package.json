{
  "name": "iconserve",
  "version": "0.1.0",
  "description": "Agent-readable static icon service (Lucide, Heroicons, Tabler, Simple Icons) on Cloudflare Workers.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "ingest": "node scripts/ingest.mjs",
    "embed": "node scripts/embed.mjs",
    "build:data": "npm run ingest && npm run embed",
    "upload:r2": "node scripts/upload.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@tabler/icons": "^3.0.0",
    "@xenova/transformers": "^2.17.2",
    "heroicons": "^2.1.5",
    "lucide-static": "^0.400.0",
    "simple-icons": "^12.0.0",
    "typescript": "^5.5.4",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2"
  }
}
